# Copy to .env locally. Never commit real values.
# The default is the first SimNow set for actual-market-hours observation.
# Set this process variable to simnow_second_7x24 only for the no-write
# --api-diagnostic or --engineering-strategy-observation paths.
ITER22_SIMNOW_PROFILE=simnow_first_group1

CTP_USER_ID=
CTP_PASSWORD=
CTP_BROKER_ID=9999
# SimNow's public defaults.  Keep your investor ID and password local.
CTP_APP_ID=simnow_client_test
CTP_AUTH_CODE=0000000000000000

# The runner resolves fronts from the frozen profiles in config.yaml. These
# reference names make the two local choices visible but are not used as free-
# form endpoint overrides:
# ITER22_SIMNOW_FIRST_GROUP1_TD_FRONT=tcp://180.168.146.187:10201
# ITER22_SIMNOW_FIRST_GROUP1_MD_FRONT=tcp://180.168.146.187:10211
# ITER22_SIMNOW_SECOND_7X24_TD_FRONT=tcp://180.168.146.187:10130
# ITER22_SIMNOW_SECOND_7X24_MD_FRONT=tcp://180.168.146.187:10131

# Do not place an approval trust root in this ordinary SimNow credential file.
# When genuine admission is available, inject ITER22_APPROVAL_KEY_ID and
# ITER22_APPROVAL_HMAC_KEY from an operator-owned process secret store only.
# They are intentionally not written to reports, manifests, requests or receipts.

# Optional explicit pair override. Set both or neither; the pair must exactly
# match the selected frozen profile. Prefer ITER22_SIMNOW_PROFILE instead.
CTP_TD_FRONT=
CTP_MD_FRONT=

# Compatibility aliases are read only when the corresponding CTP_* key is
# absent. Prefer CTP_* for new setups. Never fill more than one name per value.
# SIMNOW_USER_ID=
# SIMNOW_PASSWORD=
# SIMNOW_BROKER_ID=9999
# SIMNOW_APP_ID=
# SIMNOW_AUTH_CODE=
# SIMNOW_TD_FRONT=
# SIMNOW_MD_FRONT=
# simnow_user_id=
# simnow_password=
