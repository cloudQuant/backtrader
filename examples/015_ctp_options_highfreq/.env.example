# This replay example loads credentials only through the local launcher
# (simnow_launcher.py) and keeps them in an ignored .env file. Do not copy
# credentials into config.yaml, fixtures, reports, or command lines.
#
# Copy to .env locally. The front pairs are owned by bt_api_ctp; select one of
# the frozen environment keys declared in run.py::ENVIRONMENT_PROFILES instead
# of writing an endpoint here:
#   ITER30_SIMNOW_PROFILE=simnow_first_group1   # first set, real market hours
#   ITER30_SIMNOW_PROFILE=simnow_second_7x24    # second set, 7x24 engineering
CTP_USER_ID=
CTP_PASSWORD=
CTP_BROKER_ID=9999
CTP_APP_ID=simnow_client_test
CTP_AUTH_CODE=
# ITER30_SIMNOW_PROFILE=simnow_first_group1
