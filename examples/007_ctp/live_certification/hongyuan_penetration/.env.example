# 宏源期货仿真账号凭证
# 复制此文件为 .env 并填入实际账号信息
# 注意: 不要将 .env 文件提交到版本控制!

# 宏源期货仿真账号
HONGYUAN_USER_ID=你的投资者代码
HONGYUAN_PASSWORD=你的密码

# 可选: 环境选择 (telecom 或 unicom, 默认 telecom)
# HONGYUAN_ENV=telecom

# 可选: 交易合约 (默认 rb2701; rb2605/rb2610 已不活跃)
# CTP 合约名区分大小写且因交易所而异: SHFE/DCE 用小写原生 id (rb2701),
# CZCE 用大写别名 (SA2701 -> 原生 SA701)。写小写 sa2701 会导致行情订阅
# 与执行门禁都拿不到合约。套件会通过 store.get_symbol_info 自动解析大小写,
# 已知不合规时仍建议显式写成规范形式。rb2701 行情较稀疏, 认证优先用 SA2701。
# HONGYUAN_ORDER_SYMBOL=SA2701
# HONGYUAN_TICK_SYMBOL=SA2701

# 可选: 持仓模式 (net 或 dual_side, 默认 dual_side)
# 宏源仿真账户在 SHFE 同时持有多空两腿, net 模式会在 broker.start() 拒绝启动;
# 只有把账户调成单向/空仓后才能用 net 模式。
# HONGYUAN_POSITION_MODE=dual_side
