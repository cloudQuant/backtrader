# NON-RUNNABLE planning template: schema-v4 field layout, EnvRef values only.
# The current config_yaml parser DOES NOT resolve !EnvRef. Do not rename this
# file to config.yaml or pass it to a runner. A separately reviewed secure
# renderer/resolver and protected owner custody are required before deployment.
# No environment variables are read by ctp_000_install_plan.
# The fixed scripts/ctp_000_deployment_cli.py config renderer implements this
# exact field/name contract; it is admission-gated and never executes this YAML.
# Explicit recommended profile: SIMNOW_ENV_ACCOUNT_CTP_SETTINGS. On Windows,
# lowercase simnow_user_id/password are the same names as their uppercase forms.
# CTP broker/AppID/auth/front settings still need independent SimNow binding.
# Front pair, contract/exchange and observation window remain operator inputs.
# The window belongs to admission evidence, not to this runtime config schema.
config_schema_version: 4
strategy:
  id: example.000_live_certification.simnow_penetration
runtime:
  mode: simulation
  preset: sandbox
parameters: {}
secrets_ref: config_yaml
ctp:
  front_pairs:
    - md_front: !EnvRef CTP_MD_FRONT
      td_front: !EnvRef CTP_TD_FRONT
  instrument_id: !EnvRef CTP_INSTRUMENT
  exchange_id: !EnvRef CTP_EXCHANGE
  hedge_flag: !EnvRef CTP_HEDGE_FLAG
  broker_id: !EnvRef CTP_BROKER_ID
  user_id: !EnvRef simnow_user_id
  password: !EnvRef simnow_password
  app_id: !EnvRef CTP_APP_ID
  auth_code: !EnvRef CTP_AUTH_CODE
