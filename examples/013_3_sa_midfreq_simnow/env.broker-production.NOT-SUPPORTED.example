# Future broker-production CTP profile — template only; it does not enable trading.
#
# Current Iteration 22 runner intentionally rejects production CTP.  Do not copy
# this file to .env and expect it to work.  It exists to keep future account,
# credential, state and approval material separate from SimNow when an audited
# production adapter is available.

CTP_BROKER_ID=<provided-by-futures-company>
CTP_USER_ID=<production-investor-id>
CTP_PASSWORD=<production-password>
CTP_APP_ID=<provided-by-futures-company>
CTP_AUTH_CODE=<provided-by-futures-company>
CTP_TD_FRONT=<signed-broker-td-front>
CTP_MD_FRONT=<signed-broker-md-front>

# These must be distinct from the SimNow approval key and its evidence/journal roots.
BROKER_CTP_APPROVAL_KEY_ID=<production-operator-key-id>
BROKER_CTP_APPROVAL_HMAC_KEY=<operator-held-secret-not-committed>
BROKER_CTP_STATE_DIRECTORY=state/broker-production
BROKER_CTP_EVIDENCE_DIRECTORY=reports/broker-production
