+            "connection_generation": result.connection_generation,
+            "trading_day": TRADING_DAY,
+            "request_filter_names": ["BrokerID", "InvestorID"],
+            "request_filters_sha256": _digest(
+                {
+                    "filters": [["BrokerID", BROKER_ID], ["InvestorID", USER_ID]],
+                    "explicit_filters": [],
+                }
+            ),
+            "terminal_callback_records_sha256": hashlib.sha256(
+                repr(result.records).encode("utf-8")
+            ).hexdigest(),
+            "terminal_callback_history_sha256": hashlib.sha256(
+                b"fake-current-settlement-history"
+            ).hexdigest(),
+            "record_count": 1,
