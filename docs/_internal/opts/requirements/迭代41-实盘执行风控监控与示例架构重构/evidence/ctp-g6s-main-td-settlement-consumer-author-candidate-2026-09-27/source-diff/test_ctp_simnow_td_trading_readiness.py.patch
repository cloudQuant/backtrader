+            "started_at_utc": (now - timedelta(milliseconds=10)).isoformat(),
+            "completed_at_utc": now.isoformat(),
+            "expires_at_utc": (now + timedelta(seconds=30)).isoformat(),
+            "execution_authorized": False,
+        }
