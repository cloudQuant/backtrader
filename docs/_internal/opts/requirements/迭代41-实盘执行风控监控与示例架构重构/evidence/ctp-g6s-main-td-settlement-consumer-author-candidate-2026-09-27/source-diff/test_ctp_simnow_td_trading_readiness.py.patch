+        mutation: tuple[str, Any] | None = None,
+        fail: bool = False,
+        monotonic_expired: bool = False,
+        wrong_type: bool = False,
+    ) -> None:
+        self.source_manifest_sha256 = source_manifest_sha256
+        self.mutation = mutation
+        self.fail = fail
+        self.monotonic_expired = monotonic_expired
+        self.wrong_type = wrong_type
+        self.calls = 0
+
+    def verify_current(self, _client: Any, result: Any) -> CtpSettlementConfirmationEvidence:
+        self.calls += 1
+        if self.fail:
+            raise ValueError("stale SDK source history")
+        if self.wrong_type:
+            return SimpleNamespace(as_public_dict=lambda: {})  # type: ignore[return-value]
+        now = datetime.now(timezone.utc)
+        record = result.records[0]
+        public: dict[str, Any] = {
+            "schema": "ctp_settlement_confirmation_evidence.v1",
+            "request_type": "settlement_confirmation",
+            "request_id": result.request_id,
+            "complete": True,
+            "is_last_seen": True,
+            "timed_out": False,
+            "unsupported": False,
+            "error_code": 0,
+            "submit_code": 0,
+            "late_callback_count": 0,
+            "account_fingerprint_sha256": hashlib.sha256(
