+def _required_read_text(value: Any, name: str) -> None:
+    _required_text(value, name)
+    if value != value.strip():
+        raise ValueError(f"{name} must be exact text without surrounding whitespace")
+
+
+def _validate_read_timeout(value: Any) -> None:
+    try:
+        valid = type(value) in {int, float} and value >= 0 and math.isfinite(float(value))
+    except (OverflowError, TypeError, ValueError):
+        valid = False
+    if not valid:
+        raise ValueError("timeout_seconds must be finite and nonnegative")
+
