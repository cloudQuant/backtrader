+class CtpReadPortContractError(ValueError):
+    """Local read-contract mismatch; never a provider or account admission result."""
+
+    def __init__(self, code: str) -> None:
+        self.code = code
+        super().__init__(code.replace("_", " "))
+
+
+class CtpReadQueryKindV1(str, Enum):
+    """The narrow read-query set exposed by this contract slice."""
+
+    POSITIONS = "positions"
+    TRADES = "trades"
+
+
+@dataclass(frozen=True)
+class CtpReadQueryScopeV1:
+    """Exact caller-requested wire scope, not an authenticated account binding."""
+
+    exchange_id: str
+    instrument_id: str
+    trading_day: str
+
+    def __post_init__(self) -> None:
+        for name in ("exchange_id", "instrument_id", "trading_day"):
+            _required_read_text(getattr(self, name), name)
+
+
+@dataclass(frozen=True)
+class CtpReadQueryRequestV1:
+    """Typed read request routed through one caller-held port instance."""
+
+    kind: CtpReadQueryKindV1
+    correlation_id: str
+    scope: CtpReadQueryScopeV1
+    timeout_seconds: float
+
+    def __post_init__(self) -> None:
+        if type(self.kind) is not CtpReadQueryKindV1:
+            raise ValueError("kind must be CtpReadQueryKindV1")
+        _required_read_text(self.correlation_id, "correlation_id")
+        if type(self.scope) is not CtpReadQueryScopeV1:
+            raise ValueError("scope must be CtpReadQueryScopeV1")
+        _validate_read_timeout(self.timeout_seconds)
+
+
+def _freeze_ctp_read_records(records: Any) -> tuple[Mapping[str, Any], ...]:
+    if type(records) is not tuple:
+        raise ValueError("records must be a tuple")
+    frozen = []
+    for row in records:
+        if type(row) not in {dict, MappingProxyType}:
+            raise ValueError("each read record must be an exact string-keyed mapping")
+        row = dict(row)
+        if any(type(key) is not str or not key for key in row):
+            raise ValueError("each read record must be an exact string-keyed mapping")
+        for value in row.values():
+            if type(value) not in {type(None), bool, int, float, str, Decimal}:
+                raise ValueError("read record values must be scalar data")
+            if type(value) is float and not math.isfinite(value):
+                raise ValueError("read record floats must be finite")
+            if type(value) is Decimal and not value.is_finite():
+                raise ValueError("read record decimals must be finite")
+        frozen.append(MappingProxyType(dict(row)))
+    return tuple(frozen)
+
+
+@dataclass(frozen=True)
+class CtpReadQueryReplyV1:
+    """Untrusted query observation from a port; it carries no session authority."""
+
+    kind: CtpReadQueryKindV1
+    correlation_id: str
+    complete: bool
+    terminal: bool
+    timed_out: bool
+    error_code: Optional[str]
+    records: tuple[Mapping[str, Any], ...]
+
+    def __post_init__(self) -> None:
+        if type(self.kind) is not CtpReadQueryKindV1:
+            raise ValueError("kind must be CtpReadQueryKindV1")
+        _required_read_text(self.correlation_id, "correlation_id")
+        for name in ("complete", "terminal", "timed_out"):
+            if type(getattr(self, name)) is not bool:
+                raise ValueError(f"{name} must be boolean")
+        if self.error_code is not None and type(self.error_code) is not str:
+            raise ValueError("error_code must be text or None")
+        object.__setattr__(self, "records", _freeze_ctp_read_records(self.records))
+
+
+@dataclass(frozen=True)
+class CtpQuoteRequestV1:
+    """Exact top-of-book request for the same shared-session port instance."""
+
+    correlation_id: str
+    exchange_id: str
+    instrument_id: str
+    timeout_seconds: float
+
+    def __post_init__(self) -> None:
+        _required_read_text(self.correlation_id, "correlation_id")
+        _required_read_text(self.exchange_id, "exchange_id")
+        _required_read_text(self.instrument_id, "instrument_id")
+        _validate_read_timeout(self.timeout_seconds)
+
+
+@dataclass(frozen=True)
+class CtpQuoteReplyV1:
+    """Untrusted quote observation; timestamps and prices are not freshness proof."""
+
+    correlation_id: str
+    exchange_id: str
+    instrument_id: str
+    sequence: int
+    observed_at_utc: str
+    bid_price: Decimal
+    ask_price: Decimal
+    bid_volume: int
+    ask_volume: int
+
+    def __post_init__(self) -> None:
+        for name in ("correlation_id", "exchange_id", "instrument_id", "observed_at_utc"):
+            _required_read_text(getattr(self, name), name)
+        if type(self.sequence) is not int or self.sequence <= 0:
+            raise ValueError("sequence must be a positive exact integer")
+        for name in ("bid_price", "ask_price"):
+            value = getattr(self, name)
+            if type(value) is not Decimal or not value.is_finite() or value <= 0:
+                raise ValueError(f"{name} must be a positive finite Decimal")
+        if self.bid_price > self.ask_price:
+            raise ValueError("bid_price cannot exceed ask_price")
+        for name in ("bid_volume", "ask_volume"):
+            value = getattr(self, name)
+            if type(value) is not int or value < 0:
+                raise ValueError(f"{name} must be a nonnegative exact integer")
+
+
+class CtpSharedSessionReadPortV1(Protocol):
+    """Read-only protocol shape for an externally owned shared MD/TD session.
+
+    Implementing this protocol does not establish actor identity, authenticated
+    account scope, a common snapshot, Store admission, or production readiness.
+    The method surface intentionally contains no connect, arm, submit, cancel,
+    settlement-confirm, or lifecycle operation. This candidate does not bind a
+    port into ``BtApiStore``.
+    """
+
+    def query_read_only(self, request: CtpReadQueryRequestV1) -> CtpReadQueryReplyV1:
+        """Return one untrusted terminal observation for a positions/trades read."""
+
+    def read_quote(self, request: CtpQuoteRequestV1) -> CtpQuoteReplyV1:
+        """Return one untrusted exact-scope quote observation."""
+
+
+@dataclass(frozen=True)
+class CtpReadQueryAssessmentV1:
+    """Local shape/scope assessment; never a preflight or authorization receipt."""
+
+    complete: bool
+    scope_valid: bool
+    error_code: Optional[str]
+    scope_validation_errors: tuple[str, ...]
+    records: tuple[Mapping[str, Any], ...]
+
+
+def assess_ctp_shared_session_query(
+    port: CtpSharedSessionReadPortV1, request: CtpReadQueryRequestV1
+) -> CtpReadQueryAssessmentV1:
+    """Call the read-only query surface and check local type/completion/scope.
+
+    A fake port can exercise this contract. Its return values remain caller-side
+    observations and cannot be promoted to account identity, shared-session
+    coherence, or runtime admission evidence.
+    """
+
+    if type(request) is not CtpReadQueryRequestV1:
+        raise CtpReadPortContractError("read_query_request_type_invalid")
+    try:
+        request.__post_init__()
+    except (TypeError, ValueError):
+        raise CtpReadPortContractError("read_query_request_invalid") from None
+    reply = port.query_read_only(request)
+    if type(reply) is not CtpReadQueryReplyV1:
+        raise CtpReadPortContractError("read_query_reply_type_invalid")
+    try:
+        reply.__post_init__()
+    except (TypeError, ValueError):
+        raise CtpReadPortContractError("read_query_reply_invalid") from None
+
+    scope_errors = set()
+    if request.kind is CtpReadQueryKindV1.TRADES:
+        for row in reply.records:
+            if (
+                type(row.get("ExchangeID")) is not str
+                or row.get("ExchangeID") != request.scope.exchange_id
+            ):
+                scope_errors.add("trades_response_exchange_scope_mismatch")
+            if (
+                type(row.get("InstrumentID")) is not str
+                or row.get("InstrumentID") != request.scope.instrument_id
+            ):
+                scope_errors.add("trades_response_instrument_scope_mismatch")
+            if (
+                type(row.get("TradingDay")) is not str
+                or row.get("TradingDay") != request.scope.trading_day
+            ):
+                scope_errors.add("trades_response_trading_day_scope_mismatch")
+
+    error_code = None
+    if reply.kind is not request.kind:
+        error_code = f"{request.kind.value}_request_type_mismatch"
+    elif reply.correlation_id != request.correlation_id:
+        error_code = "read_query_correlation_mismatch"
+    elif scope_errors:
+        error_code = "trade_scope_validation_failed"
+    elif reply.complete is not True or reply.terminal is not True or reply.timed_out is not False:
+        error_code = reply.error_code or f"{request.kind.value}_query_incomplete"
+    elif reply.error_code not in (None, ""):
+        error_code = reply.error_code
+
+    return CtpReadQueryAssessmentV1(
+        complete=error_code is None,
+        scope_valid=not scope_errors,
+        error_code=error_code,
+        scope_validation_errors=tuple(sorted(scope_errors)),
+        records=reply.records,
+    )
+
+
+def read_ctp_shared_session_quote(
+    port: CtpSharedSessionReadPortV1, request: CtpQuoteRequestV1
+) -> CtpQuoteReplyV1:
+    """Read and scope-check one quote; do not infer freshness or actor authority."""
+
+    if type(request) is not CtpQuoteRequestV1:
+        raise CtpReadPortContractError("quote_request_type_invalid")
+    try:
+        request.__post_init__()
+    except (TypeError, ValueError):
+        raise CtpReadPortContractError("quote_request_invalid") from None
+    reply = port.read_quote(request)
+    if type(reply) is not CtpQuoteReplyV1:
+        raise CtpReadPortContractError("quote_reply_type_invalid")
+    try:
+        reply.__post_init__()
+    except (TypeError, ValueError):
+        raise CtpReadPortContractError("quote_reply_invalid") from None
+    if reply.correlation_id != request.correlation_id:
+        raise CtpReadPortContractError("quote_correlation_mismatch")
+    if (reply.exchange_id, reply.instrument_id) != (request.exchange_id, request.instrument_id):
+        raise CtpReadPortContractError("quote_scope_mismatch")
+    return reply
+
