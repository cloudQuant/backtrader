+        assert store.read_ctp_dispatch_command(scope, arguments["command_id"]) is None
+        assert store._connection.execute(
+            "SELECT COUNT(*) FROM ctp_native_action_ref_counters WHERE account_key = ?",
+            (scope.account_key,),
