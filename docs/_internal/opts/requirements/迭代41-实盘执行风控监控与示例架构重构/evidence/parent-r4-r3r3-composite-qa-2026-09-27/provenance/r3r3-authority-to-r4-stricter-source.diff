+def is_registered_offline_fake_binding(
+    contract: Any,
+    execution_scope: Any,
+    policy_id: object,
+    risk_scope: Any | None = None,
+) -> bool:
+    """Check the code-owned, exact offline fake-composition allowlist.
+
+    ``provider='fake'`` on the risk scope is not sufficient: a mismatched
+    execution scope must not borrow fake proof authority for a CTP-labeled or
+    otherwise unregistered account.  This predicate intentionally recognizes
+    only the two fixed replay compositions in this module.
+    """
+
+    strategy_id = getattr(execution_scope, "strategy_id", None)
+    provider = getattr(execution_scope, "provider", None)
+    account_ref = getattr(execution_scope, "account_ref", None)
+    if (
+        type(strategy_id) is not str
+        or type(provider) is not str
+        or type(account_ref) is not str
+        or type(policy_id) is not str
+        or getattr(contract, "strategy_id", None) != strategy_id
+        or getattr(contract, "mode", None) != "simulation"
+        or getattr(contract, "preset", None) != "replay"
+        or getattr(contract, "environment", None) != "offline"
+        or getattr(contract, "order_route", None) != "managed_execution"
+        or getattr(execution_scope, "environment", None) != "offline"
+        or (strategy_id, provider, account_ref, policy_id) not in _OFFLINE_FAKE_POLICY_BINDINGS
+    ):
+        return False
+    return risk_scope is None or (
+        getattr(risk_scope, "provider", None) == "fake"
+        and getattr(risk_scope, "environment", None) == "offline"
+        and getattr(risk_scope, "account_id", None) == account_ref
+    )
 
