+@dataclass(frozen=True)
+class StoreRouteSnapshot:
+    """Immutable semantic route snapshot for per-operation mutation checks.
+
+    The snapshot stores only canonical bytes and a digest. Replacing a mutable
+    input mapping with equal content preserves the route; any semantic change
+    changes the digest. Opaque client objects are represented only by presence
+    bits and are rejected by route classification before snapshot capture.
+    """
+
+    route_kind: RouteKind
+    canonical_bytes: bytes
+    digest: str
+
+
+def capture_store_route_snapshot(route: StoreRouteDescriptor) -> StoreRouteSnapshot:
+    """Capture only exact built-in route data without reading injected objects."""
+
+    fields = _store_route_fields(route)
+    if fields is None:
+        raise AccountActorGateError("store_route_snapshot_invalid")
+    try:
+        canonical = {
+            "schema": "store-route-snapshot.v1",
+            "fields": {
+                "provider": _route_value(fields["provider"]),
+                "backend": _route_value(fields["backend"]),
+                "config": _route_value(fields["config"]),
+                "api_kwargs": _route_value(fields["api_kwargs"]),
+                "api_present": fields["api"] is not None,
+                "api_cls_present": fields["api_cls"] is not None,
+                "environment_provider": _route_value(fields["environment_provider"]),
+                "environment_exchange_type": _route_value(
+                    fields["environment_exchange_type"]
+                ),
+            },
+        }
+        canonical_bytes = json.dumps(
+            canonical, sort_keys=True, separators=(",", ":"), ensure_ascii=True
+        ).encode("ascii")
+    except (TypeError, ValueError, RecursionError, RuntimeError):
+        raise AccountActorGateError("store_route_snapshot_invalid") from None
+    kind = classify_store_route(route)
+    return StoreRouteSnapshot(
+        route_kind=kind,
+        canonical_bytes=canonical_bytes,
+        digest=hashlib.sha256(canonical_bytes).hexdigest(),
+    )
+
+
+def _store_route_fields(route: Any) -> Optional[dict[str, Any]]:  # noqa: UP045 - Python 3.8
+    """Read the exact frozen descriptor's instance dictionary only.
+
+    This avoids invoking caller-provided Mapping methods, object properties,
+    API descriptors, or subclass hooks during route checks.
+    """
+
+    if type(route) is not StoreRouteDescriptor:
+        return None
+    try:
+        fields = object.__getattribute__(route, "__dict__")
+    except (AttributeError, TypeError):
+        return None
+    expected = {
+        "provider",
+        "backend",
+        "config",
+        "api_kwargs",
+        "api",
+        "api_cls",
+        "environment_provider",
+        "environment_exchange_type",
+    }
+    if type(fields) is not dict or set(fields) != expected:
+        return None
+    return fields
+
+
+def _route_value(
+    value: Any, *, _active: Optional[set[int]] = None, _depth: int = 0  # noqa: UP045 - Python 3.8
+) -> Any:
+    """Return a type-tagged JSON value, rejecting opaque or hostile objects."""
+
+    if _depth > 64:
+        raise ValueError("route value nesting limit exceeded")
+    if value is None:
+        return ["none"]
+    if type(value) is bool:
+        return ["bool", value]
+    if type(value) is int:
+        return ["int", str(value)]
+    if type(value) is str:
+        return ["str", value]
+    if type(value) is float:
+        if not math.isfinite(value):
+            raise ValueError("non-finite route number")
+        return ["float", value.hex()]
+    if type(value) is Decimal:
+        if not value.is_finite():
+            raise ValueError("non-finite route decimal")
+        return ["decimal", str(value)]
+    if type(value) is bytes:
+        return ["bytes", value.hex()]
+
+    if type(value) not in {dict, list, tuple}:
+        raise TypeError("route snapshot accepts exact built-in values only")
+    active = _active if _active is not None else set()
+    identity = id(value)
+    if identity in active:
+        raise ValueError("cyclic route value")
+    active.add(identity)
+    try:
+        if type(value) is dict:
+            if any(type(key) is not str for key in value):
+                raise TypeError("route mapping keys must be exact strings")
+            if len(value) > 10000:
+                raise ValueError("route mapping is too large")
+            return [
+                "dict",
+                [
+                    [key, _route_value(value[key], _active=active, _depth=_depth + 1)]
+                    for key in sorted(value)
+                ],
+            ]
+        if len(value) > 10000:
+            raise ValueError("route sequence is too large")
+        tag = "list" if type(value) is list else "tuple"
+        return [tag, [_route_value(item, _active=active, _depth=_depth + 1) for item in value]]
+    finally:
+        active.remove(identity)
+
