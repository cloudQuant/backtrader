+class _StoreBoundSdkApiView:
+    """Route-checked public view over an SDK object retained by a Store.
+
+    Methods are wrapped so a reference obtained before a Store route change
+    cannot keep dispatching through the old client. Private attributes and
+    opaque non-callable client objects are never exposed through this view.
+    This is a compatibility guard, not an in-process isolation boundary:
+    same-process Python code can still inspect the Store's private ``_api``.
+    """
+
+    __slots__ = ("_store", "_api")
+
+    def __init__(self, store: "BtApiStore", api: Any):
+        self._store = store
+        self._api = api
+
+    def __getattr__(self, name: str) -> Any:
+        if not isinstance(name, str) or name.startswith("_"):
+            raise AttributeError(name)
+        self._store._candidate_require_route(RouteKind.NON_CTP)
+        value = getattr(self._api, name)
+        if callable(value):
+            def guarded_call(*args, **kwargs):
+                self._store._candidate_require_route(RouteKind.NON_CTP)
+                result = value(*args, **kwargs)
+                self._store._candidate_require_route(RouteKind.NON_CTP)
+                return result
+
+            return guarded_call
+        if value is None or type(value) in (str, bytes, int, float, bool):
+            return value
+        if type(value) in (dict, list, tuple, set, frozenset):
+            return deepcopy(value)
+        raise BtApiStoreError("sdk_api view does not expose opaque client attributes")
 
 
