+def test_route_mutation_after_queue_blocks_sdk_worker_before_api_dispatch():
+    import asyncio
+
+    class _DispatchApi:
+        exchange_kwargs = {}
+
+        def __init__(self):
+            self.calls = []
+
+        async def async_query_order(self, *args, **kwargs):
+            self.calls.append((args, kwargs))
+            return {"status": "ok"}
+
+    api = _DispatchApi()
+    store = BtApiStore(provider="okx", api=api, config={"exchange_type": "OKX"})
+    command = {
+        "operation": "query",
+        "venue": "okx",
+        "request": object(),
+        "priority": "query",
+    }
+    receipt = store._enqueue_sdk_command(command, priority_name="query")
+    assert receipt["queued"] is True
+    assert api.calls == []
+
+    store._config["exchange_type"] = "CTP"
+    completion = asyncio.run(store._execute_sdk_command(command))
+    assert completion["status"] == "failed"
+    assert completion["definite_reject"] is True
+    assert completion["execution_unknown"] is False
+    assert completion["error_code"] == "store_route_changed"
+    assert api.calls == []
