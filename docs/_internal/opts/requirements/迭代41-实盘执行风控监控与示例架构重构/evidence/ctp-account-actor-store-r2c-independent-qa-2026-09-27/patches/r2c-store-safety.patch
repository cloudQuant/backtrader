+def test_retained_sdk_api_method_rechecks_route_before_provider_call():
+    class _RetainedApi:
+        exchange_kwargs = {}
+
+        def __init__(self):
+            self.calls = []
+            self.client = object()
+
+        def read_marker(self):
+            self.calls.append("read_marker")
+            return {"ok": True}
+
+    api = _RetainedApi()
+    store = BtApiStore(provider="okx", api=api, config={"exchange_type": "OKX"})
+    retained = store.sdk_api
+    retained_method = retained.read_marker
+    assert retained_method() == {"ok": True}
+    assert api.calls == ["read_marker"]
+
+    store._config["exchange_type"] = "CTP"
+    with pytest.raises(BtApiStoreError, match="route changed"):
+        retained_method()
+    with pytest.raises(BtApiStoreError, match="route changed"):
+        retained.read_marker
+    assert api.calls == ["read_marker"]
+
+    store._config["exchange_type"] = "OKX"
+    with pytest.raises(BtApiStoreError, match="opaque client attributes"):
+        _ = store.sdk_api.client
+    assert retained is not api
