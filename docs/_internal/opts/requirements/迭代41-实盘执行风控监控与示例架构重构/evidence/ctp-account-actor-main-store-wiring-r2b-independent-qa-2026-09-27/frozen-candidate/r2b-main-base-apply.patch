+def _candidate_nested_route_snapshot(value: Any, seen: Optional[set] = None) -> Any:
+    """Copy only route selectors from exact built-in dicts; never copy secrets."""
+    seen = set() if seen is None else seen
+    if type(value) is not dict or id(value) in seen:
+        return None
+    identity = id(value)
+    seen.add(identity)
+    result: Dict[str, Any] = {}
+    for key, nested in value.items():
+        if type(key) is not str:
+            continue
+        if key in _CANDIDATE_NESTED_ROUTE_KEYS:
+            result[key] = nested if type(nested) is str else None
+        elif key == "exchange_kwargs":
+            result[key] = _candidate_exchange_kwargs_snapshot(nested, seen)
+        elif key == "symbol_routes":
+            result[key] = _candidate_symbol_routes_snapshot(nested, seen)
+        elif type(nested) is dict:
+            child = _candidate_nested_route_snapshot(nested, seen)
+            if child:
+                result[key] = child
+    seen.remove(identity)
+    return result
+
