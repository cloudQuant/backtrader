+def _candidate_nested_route_snapshot(value: Any, seen: Optional[set] = None) -> Any:
+    """Copy only route selectors from exact built-in dicts; never copy secrets."""
+    seen = set() if seen is None else seen
+    if type(value) is not dict or id(value) in seen:
+        return None
+    identity = id(value)
+    seen.add(identity)
+    result: Dict[str, Any] = {}
+    for key, nested in value.items():
+        if type(key) is not str:
+            continue
+        if key in _CANDIDATE_NESTED_ROUTE_KEYS:
+            result[key] = nested if type(nested) is str else None
+        elif key == "exchange_kwargs":
+            result[key] = _candidate_exchange_kwargs_snapshot(nested, seen)
+        elif key == "symbol_routes":
+            result[key] = _candidate_symbol_routes_snapshot(nested, seen)
+        elif type(nested) is dict:
+            child = _candidate_nested_route_snapshot(nested, seen)
+            if child:
+                result[key] = child
+    seen.remove(identity)
+    return result
+
+
+def _candidate_exchange_kwargs_snapshot(value: Any, seen: Optional[set] = None) -> Any:
+    if type(value) is not dict:
+        return None
+    seen = set() if seen is None else seen
+    if id(value) in seen:
+        return None
+    identity = id(value)
+    seen.add(identity)
+    result: Dict[str, Any] = {}
+    for key, options in value.items():
+        if type(key) is not str:
+            continue
+        result[key] = _candidate_nested_route_snapshot(options, seen) if type(options) is dict else None
+    seen.remove(identity)
+    return result
+
+
+def _candidate_symbol_routes_snapshot(value: Any, seen: Optional[set] = None) -> Any:
+    if type(value) is not dict:
+        return None
+    seen = set() if seen is None else seen
+    if id(value) in seen:
+        return None
+    identity = id(value)
+    seen.add(identity)
+    result: Dict[str, Any] = {}
+    for key, route in value.items():
+        if type(key) is not str:
+            continue
+        if type(route) is str:
+            result[key] = route
+        elif type(route) is dict:
+            result[key] = _candidate_nested_route_snapshot(route, seen)
+        else:
+            result[key] = None
+    seen.remove(identity)
+    return result
+
+
+def _candidate_detach_route_tree(value: Any, seen: Optional[set] = None) -> Any:
+    """Detach exact dictionaries without inspecting or copying leaf objects."""
+    if type(value) is not dict:
+        return value
+    seen = set() if seen is None else seen
+    if id(value) in seen:
+        return value
+    identity = id(value)
+    seen.add(identity)
+    result = {key: _candidate_detach_route_tree(nested, seen) for key, nested in value.items()}
+    seen.remove(identity)
+    return result
+
+
+def _candidate_detach_route_value(key: str, value: Any) -> Any:
+    if key in {"exchange_kwargs", "symbol_routes"} and type(value) is dict:
+        return _candidate_detach_route_tree(value)
+    return value
+
+
+def _candidate_route_mapping_snapshot(value: Any) -> Any:
+    if value is None:
+        return {}
+    if type(value) is not dict:
+        return value
+    result: Dict[str, Any] = {}
+    for key in _CANDIDATE_ROUTE_KEYS:
+        if key not in value:
+            continue
+        nested = value[key]
+        if key == "exchange_kwargs":
+            result[key] = _candidate_exchange_kwargs_snapshot(nested)
+        elif key == "symbol_routes":
+            result[key] = _candidate_symbol_routes_snapshot(nested)
+        else:
+            result[key] = nested if type(nested) is str else None
+    return result
+
+
+def _candidate_merge_api_route_snapshot(api_kwargs: Any, extra_kwargs: Dict[str, Any]) -> Any:
+    if api_kwargs is None:
+        base: Any = {}
+    elif type(api_kwargs) is dict:
+        base = _candidate_route_mapping_snapshot(api_kwargs)
+    else:
+        return api_kwargs
+    if type(base) is not dict:
+        return base
+    for key in _CANDIDATE_ROUTE_KEYS:
+        if key not in extra_kwargs:
+            continue
+        value = extra_kwargs[key]
+        if key == "exchange_kwargs":
+            base[key] = _candidate_exchange_kwargs_snapshot(value)
+        elif key == "symbol_routes":
+            base[key] = _candidate_symbol_routes_snapshot(value)
+        else:
+            base[key] = value if type(value) is str else None
+    return base
+
+
+def _candidate_route_descriptor(provider: Any, backend: Any, config: Any, api_kwargs: Any,
+                                api: Any, api_cls: Any, environment_provider: Any = None,
+                                environment_exchange_type: Any = None) -> StoreRouteDescriptor:
+    return StoreRouteDescriptor(
+        provider=provider, backend=backend,
+        config=_candidate_route_mapping_snapshot(config),
+        api_kwargs=_candidate_route_mapping_snapshot(api_kwargs),
+        api=api, api_cls=api_cls,
+        environment_provider=environment_provider,
+        environment_exchange_type=environment_exchange_type,
+    )
+
+
+def _candidate_route_fingerprint(route: StoreRouteDescriptor) -> str:
+    payload = {
+        "provider": route.provider if type(route.provider) is str else None,
+        "backend": route.backend if type(route.backend) is str else None,
+        "config": route.config, "api_kwargs": route.api_kwargs,
+        "environment_provider": route.environment_provider if type(route.environment_provider) is str else None,
+        "environment_exchange_type": route.environment_exchange_type if type(route.environment_exchange_type) is str else None,
+    }
+    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
+    return hashlib.sha256(encoded.encode("ascii")).hexdigest()
 
