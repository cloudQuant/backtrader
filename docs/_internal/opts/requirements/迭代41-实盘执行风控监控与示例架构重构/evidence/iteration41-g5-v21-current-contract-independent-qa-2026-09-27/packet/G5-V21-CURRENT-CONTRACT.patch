+            correlation_key=command.correlation_key,
+            local_queue_receipt_id=command.local_queue_receipt_id,
+        )
+
+
+__all__ = [
+    "CtpI9AccountSessionCandidate",
+    "CtpI9AccountSessionCandidateError",
