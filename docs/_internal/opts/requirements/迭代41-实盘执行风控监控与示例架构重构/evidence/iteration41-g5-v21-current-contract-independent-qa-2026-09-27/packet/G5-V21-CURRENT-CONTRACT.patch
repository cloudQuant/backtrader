+"""Isolated fake-only account ActionRef floor test composition root.
+
+This helper patches a test Store instance with a synthetic snapshot. The
+snapshot is not native evidence, a trusted floor, an account-wide writer
+fence, or permission to dispatch.
+"""
+
+from __future__ import annotations
+
+from hashlib import sha256
+from types import MethodType
+
+from bt_api_execution import SqliteExecutionStore
+from bt_api_execution.store import CtpNativeActionRefFloorSnapshot
+
+
+def create_fake_action_ref_store(
+    *args, fake_native_action_ref_floor: int = 0, **kwargs
+) -> SqliteExecutionStore:
+    """Construct the exact Store type and add one test-only floor seam."""
+
+    store = SqliteExecutionStore(*args, **kwargs)
+    store._test_fake_native_action_ref_floor = fake_native_action_ref_floor
+    store._test_fake_floor_overrides = {}
+
+    def fake_floor(self, scope, *, now_ns):
+        fields = {
+            "account_key": scope.account_key,
+            "max_native_action_ref": self._test_fake_native_action_ref_floor,
+            "account_writer_epoch": "fake-only-account-writer-epoch",
+            "reconciliation_receipt_sha256": sha256(b"synthetic legacy reconciliation").hexdigest(),
+            "source_digest_sha256": sha256(b"synthetic native MaxOrderActionRef").hexdigest(),
+            "verifier_id": "fake-only-no-authority",
+            "observed_at_ns": now_ns,
+            "expires_at_ns": now_ns + 1_000_000_000,
+        }
+        fields.update(self._test_fake_floor_overrides)
+        return CtpNativeActionRefFloorSnapshot(**fields)
+
+    store._verified_ctp_native_action_ref_floor = MethodType(fake_floor, store)
+    return store
