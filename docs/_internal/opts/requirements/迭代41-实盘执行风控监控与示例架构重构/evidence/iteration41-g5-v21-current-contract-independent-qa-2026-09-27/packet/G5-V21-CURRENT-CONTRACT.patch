+from __future__ import annotations
+
+import importlib.util
+import sys
+from concurrent.futures import ThreadPoolExecutor
+from dataclasses import replace
+from hashlib import sha256
+from pathlib import Path
+
+import pytest
+from _fake_native_action_ref_floor import create_fake_action_ref_store
+from test_ctp_dispatch_commands import (
+    _authority_verifier,
+    _FakeOrderTargetProjectionVerifier,
+    _issue_target_projection,
+    _lease,
+    _prepared_managed_dispatch,
+    _reserve_seeded,
+    _scope,
+)
+
+from bt_api_execution import DurableStoreError, SqliteExecutionStore
+from bt_api_execution.ctp_single_worker_candidate import (
+    CtpManagedSingleWorkerCandidate,
+    CtpNativeDispatchResult,
+)
+
+_G5_SOURCE = Path(__file__).parent / "fixtures" / "g5" / "ctp_managed_action_authority.py"
+_G5_SOURCE_SHA256 = "7caed2a83447173ff93755c5561713c2e2f8f410d21ae78e4a07cccd3f681c66"
+_G5_NAME = "_iteration41_frozen_g5_managed_action_authority"
+_spec = importlib.util.spec_from_file_location(_G5_NAME, _G5_SOURCE)
+assert _spec is not None and _spec.loader is not None
+_g5 = importlib.util.module_from_spec(_spec)
+sys.modules[_G5_NAME] = _g5
+_spec.loader.exec_module(_g5)
+
+
+def _scope_facts(scope):
+    account_fingerprint = scope.account_key.rpartition(":")[2]
+    return _g5.CtpManagedActionScopeV1(
+        provider="ctp",
+        environment="simnow",
+        mode="simulation",
+        preset="sandbox",
+        runtime_id="runtime.iteration41.contract-test",
+        strategy_id=scope.strategy_id,
+        runtime_registration_digest=sha256(b"fake runtime registration").hexdigest(),
+        mode_registration_digest=sha256(b"fake mode registration").hexdigest(),
+        config_digest=sha256(b"fake sealed config").hexdigest(),
+        effective_digest=sha256(b"fake effective config").hexdigest(),
+        profile_digest=None,
+        account_fingerprint_sha256=account_fingerprint,
+        front_pair_sha256=sha256(b"fake front pair").hexdigest(),
+        front_pair_set_sha256=sha256(b"fake front pair set").hexdigest(),
+    )
+
+
+def _cancel_projection(store, scope, reservation):
+    return _issue_target_projection(
+        store,
+        scope,
+        reservation,
+        verifier=_FakeOrderTargetProjectionVerifier(
+            overrides={
+                "order_sys_id": "fake-sys-order",
+                "query_request_id": int(reservation.order_ref) % 2_147_483_647 or 1,
+            }
+        ),
+    )
+
+
+def test_current_g5_source_is_verifier_and_default_inventory_does_not_register_candidate():
+    authority_source = _G5_SOURCE.read_text(encoding="utf-8")
+    account_runtime_source = (
+        Path(__file__).parent / "fixtures" / "g5" / "ctp_managed_account_runtime_candidate.py"
+    ).read_text(encoding="utf-8")
+    session_source = (
+        Path(__file__).parent / "fixtures" / "g5" / "ctp_i9_account_session_candidate.py"
+    ).read_text(encoding="utf-8")
+    inventory_source = (Path(__file__).parent / "fixtures" / "g5" / "inventory.py").read_text(
+        encoding="utf-8"
+    )
+    assert "CtpUnifiedOrderActionAuthority" not in authority_source
+    assert "reserve_cancel_action_identity" not in authority_source
+    assert "ctp_action_ref_watermarks" not in authority_source
+    assert "ctp_action_identity_reservations" not in authority_source
+    assert "CtpManagedSingleWorkerCandidate" in account_runtime_source
+    assert "CtpManagedActionAuthorityAdapter" in account_runtime_source
+    assert "stage_prepared_dispatch(" in session_source
+    assert "action_identity" not in session_source
+    assert "ctp_managed_account_runtime_candidate" not in inventory_source
+
+
+def test_current_g5_digest_consumes_committed_v21_worker_mapping_across_restart(tmp_path):
+    assert sha256(_G5_SOURCE.read_bytes()).hexdigest() == _G5_SOURCE_SHA256
+    database = tmp_path / "g5-v21-actionref.sqlite3"
+    scope = _scope()
+    store = create_fake_action_ref_store(database, fake_native_action_ref_floor=37)
+    lease = _lease(store, scope)
+    try:
+        reservation = _reserve_seeded(store, scope, lease, "g5-contract-intent")
+        prepared = _prepared_managed_dispatch(reservation, operation="cancel", receipt_id="b" * 32)
+        worker = CtpManagedSingleWorkerCandidate(
+            store, scope, lease, _FakeOrderTargetProjectionVerifier()
+        )
+        # This composition is synthetic: it verifies the Store call contract,
+        # not a provider order target, floor, login, or write authority.
+        binding = worker.stage_prepared_dispatch(
+            prepared,
+            cancel_target_projection=_cancel_projection(store, scope, reservation),
+        )
+        command = store.read_ctp_dispatch_command(scope, prepared.command_id)
+        assert command is not None
+        assert command.correlation_key is not None
+        action_ref = command.correlation_key.native_action_ref
+        assert action_ref == binding.native_action_ref == 38
+        assert "OrderActionRef" not in command.request_payload
+        assert command.native_request_payload == {
+            **dict(command.request_payload),
+            "OrderActionRef": action_ref,
+        }
+        allocation = store._connection.execute(
+            "SELECT native_action_ref, scope_key, managed_action_id "
+            "FROM ctp_native_action_ref_allocations WHERE account_key = ? AND command_id = ?",
+            (scope.account_key, prepared.command_id),
+        ).fetchone()
+        assert allocation is not None
+        assert tuple(allocation) == (
+            action_ref,
+            scope.key,
+            command.correlation_key.managed_action_id,
+        )
+        action_digest = _g5.CtpManagedActionAuthorityAdapter._action_digest(
+            command, _scope_facts(scope)
+        )
+    finally:
+        store.close()
+
+    reopened = SqliteExecutionStore(database)
+    try:
+        restored = reopened.read_ctp_dispatch_command(scope, prepared.command_id)
+        assert restored == command
+        assert restored.correlation_key.native_action_ref == action_ref
+        assert (
+            _g5.CtpManagedActionAuthorityAdapter._action_digest(restored, _scope_facts(scope))
+            == action_digest
+        )
+    finally:
+        reopened.close()
+
+
+@pytest.mark.asyncio
+async def test_missing_v21_mapping_fences_g5_digest_claim_before_sender(tmp_path):
+    database = tmp_path / "g5-v21-actionref-missing-map.sqlite3"
+    scope = _scope()
+    store = create_fake_action_ref_store(database, fake_native_action_ref_floor=50)
+    lease = _lease(store, scope)
+    reservation = _reserve_seeded(store, scope, lease, "g5-missing-map-intent")
+    prepared = _prepared_managed_dispatch(reservation, operation="cancel", receipt_id="d" * 32)
+    fake_g5_scope = _scope_facts(scope)
+    base_verifier = _authority_verifier()
+
+    class FrozenG5DigestVerifier:
+        def verify_action(self, command, *, now_ns):
+            _g5.CtpManagedActionAuthorityAdapter._action_digest(command, fake_g5_scope)
+            return base_verifier.verify_action(command, now_ns=now_ns)
+
+    worker = CtpManagedSingleWorkerCandidate(store, scope, lease, FrozenG5DigestVerifier())
+    sent = []
+    try:
+        binding = worker.stage_prepared_dispatch(
+            prepared, cancel_target_projection=_cancel_projection(store, scope, reservation)
+        )
+        binding = worker.record_managed_queue_receipt(
+            prepared.command_id,
+            binding,
+            {
+                "kind": "command_receipt",
+                "command": "cancel",
+                "receipt_id": prepared.local_queue_receipt_id,
+                "queued": True,
+            },
+        )
+        store._connection.execute("DROP TRIGGER ctp_native_action_ref_allocations_immutable_delete")
+        store._connection.execute(
+            "DELETE FROM ctp_native_action_ref_allocations "
+            "WHERE account_key = ? AND command_id = ?",
+            (scope.account_key, prepared.command_id),
+        )
+
+        async def fake_sender(command):
+            sent.append(command.command_id)
+            return CtpNativeDispatchResult("QUEUED", {"kind": "fake-only-send", "return_code": 0})
+
+        with pytest.raises(DurableStoreError, match="allocation is missing or mismatched"):
+            await worker.dispatch_managed_command(prepared.command_id, binding, fake_sender)
+        assert sent == []
+        command = store.read_ctp_dispatch_command(scope, prepared.command_id)
+        assert command is not None and command.status == "READY"
+        assert command.correlation_key is not None
+        # G5's local payload transform remains internally consistent; the V21
+        # durable mapping check is the fence that prevents the native sender.
+        assert _g5.CtpManagedActionAuthorityAdapter._action_digest(command, fake_g5_scope)
+    finally:
+        store.close()
+
+
+def test_v21_same_store_concurrent_allocations_are_unique_and_missing_mapping_fences(
+    tmp_path,
+):
+    assert sha256(_G5_SOURCE.read_bytes()).hexdigest() == _G5_SOURCE_SHA256
+    database = tmp_path / "g5-v21-actionref-concurrent.sqlite3"
+    scope = _scope()
+    store = create_fake_action_ref_store(database, fake_native_action_ref_floor=37)
+    lease = _lease(store, scope)
+    try:
+        prepared_items = []
+        for label in ("parallel-a", "parallel-b"):
+            reservation = _reserve_seeded(store, scope, lease, label)
+            prepared = _prepared_managed_dispatch(
+                reservation,
+                operation="cancel",
+                receipt_id=("a" if label.endswith("a") else "c") * 32,
+            )
+            prepared = replace(
+                prepared,
+                approval_use_id="approval-use-" + label,
+                approval_digest=sha256(("approval-" + label).encode("ascii")).hexdigest(),
+            )
+            projection = _cancel_projection(store, scope, reservation)
+            worker = CtpManagedSingleWorkerCandidate(
+                store, scope, lease, _FakeOrderTargetProjectionVerifier()
+            )
+            prepared_items.append((worker, prepared, projection))
+
+        def stage(item):
+            worker, prepared, projection = item
+            return worker.stage_prepared_dispatch(prepared, cancel_target_projection=projection)
+
+        with ThreadPoolExecutor(max_workers=2) as executor:
+            bindings = list(executor.map(stage, prepared_items))
+        references = sorted(binding.native_action_ref for binding in bindings)
+        assert references == [38, 39]
+        commands = [
+            store.read_ctp_dispatch_command(scope, prepared.command_id)
+            for _worker, prepared, _projection in prepared_items
+        ]
+        assert all(command is not None for command in commands)
+        assert sorted(command.correlation_key.native_action_ref for command in commands) == [38, 39]
+        for command in commands:
+            assert _g5.CtpManagedActionAuthorityAdapter._action_digest(command, _scope_facts(scope))
+        corrupted_command = commands[0]
+        assert corrupted_command is not None and corrupted_command.correlation_key is not None
+        # Simulate offline database damage despite the normal immutable trigger.
+        store._connection.execute("DROP TRIGGER ctp_native_action_ref_allocations_immutable_delete")
+        store._connection.execute(
+            "DELETE FROM ctp_native_action_ref_allocations "
+            "WHERE account_key = ? AND command_id = ?",
+            (scope.account_key, corrupted_command.command_id),
+        )
+        row = store._connection.execute(
+            "SELECT * FROM ctp_dispatch_commands WHERE account_key = ? AND command_id = ?",
+            (scope.account_key, corrupted_command.command_id),
+        ).fetchone()
+        assert row is not None
+        # The G5 payload digest checks value consistency; it is not itself proof
+        # of a durable allocation row. V21's allocation gate detects the gap.
+        assert _g5.CtpManagedActionAuthorityAdapter._action_digest(
+            corrupted_command, _scope_facts(scope)
+        )
+        with pytest.raises(DurableStoreError, match="allocation is missing or mismatched"):
+            store._require_ctp_native_action_ref_allocation(
+                store._connection.cursor(), row, corrupted_command.correlation_key
+            )
+    finally:
+        store.close()
