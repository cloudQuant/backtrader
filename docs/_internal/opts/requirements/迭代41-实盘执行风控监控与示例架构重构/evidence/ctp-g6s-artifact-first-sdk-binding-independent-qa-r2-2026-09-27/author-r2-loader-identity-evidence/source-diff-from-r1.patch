+def test_extension_loader_replacement_during_retained_hash_read_is_rejected(
+    secure_install_root: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _clear_sdk_modules(monkeypatch)
+    root = secure_install_root
+    policy = _build_fake_distribution(root)
+    monkeypatch.setattr(sys, "path", [str(root)])
+    monkeypatch.setattr(sys, "dont_write_bytecode", True)
+    _use_standard_import_chain(monkeypatch)
+    monkeypatch.setattr(binding, "_CODE_OWNED_ARTIFACT_POLICY", policy)
+
+    readiness.require_trusted_ctp_sdk_artifact_before_client()
+    importer = binding._CODE_OWNED_IMPORTER
+    assert importer is not None
+    fullname = "bt_api_ctp.ctp._ctp"
+    spec = importer._spec_for(fullname)
+    module = types.ModuleType(fullname)
+    module.__spec__ = spec
+    module.__file__ = spec.origin
+    monkeypatch.setitem(sys.modules, fullname, module)
+    custody = importer.artifact.custody
+    assert custody is not None
+    original_read = custody.read
+    extension_relative = policy.extension_paths[0]
+    calls: list[str] = []
+
+    class InertReplacementLoader:
+        def __init__(self, fullname: str, path: str) -> None:
+            calls.append("constructed")
+
+        def create_module(self, spec: object) -> None:
+            calls.append("create_module")
+
+        def exec_module(self, module: object) -> None:
+            calls.append("exec_module")
+
+    def replace_after_read(
+        relative: str, *, max_bytes: int = 128 * 1024 * 1024
+    ) -> bytes:
+        raw = original_read(relative, max_bytes=max_bytes)
+        if relative == extension_relative:
+            monkeypatch.setattr(
+                binding.importlib.machinery,
+                "ExtensionFileLoader",
+                InertReplacementLoader,
+            )
+        return raw
+
+    monkeypatch.setattr(custody, "read", replace_after_read)
+    with pytest.raises(binding.CtpSdkArtifactBindingError) as raised:
+        spec.loader.exec_module(module)
+    assert raised.value.reason == "sdk_artifact_importlib_machinery_changed"
+    assert calls == []
+    assert fullname not in importer._loaded
