+        if type(authority) is not FakeSnapshotAuthorityV1:
+            return False
+        try:
+            bundle, proof = self._read_snapshot_cursor(
+                cursor, account_ref, snapshot_version
+            )
+        except (ActorServerError, TypeError, ValueError):
+            return False
