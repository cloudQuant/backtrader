+class AccountActorServerCoreV1:
+    """SQLite-backed fake service core with no provider/native dispatcher."""
+
+    def __init__(
+        self,
+        database_path: str,
+        *,
+        snapshot_authority: Optional[FakeSnapshotAuthorityV1] = None,  # noqa: UP045 - Python 3.8
+    ) -> None:
+        if type(database_path) is not str or not database_path.strip():
+            raise ValueError("database_path must be a nonempty filesystem path")
+        if database_path == ":memory:" or database_path.startswith("file:"):
+            raise ValueError(
+                "durable fake service requires a plain filesystem database"
+            )
+        self.database_path = os.path.abspath(database_path)
+        if (
+            snapshot_authority is not None
+            and type(snapshot_authority) is not FakeSnapshotAuthorityV1
+        ):
+            raise ValueError("snapshot_authority must be exact fake authority type")
+        self._snapshot_authority = snapshot_authority
+        self._local_lock = threading.RLock()
+        self._initialize_schema()
+
+    def close(self) -> None:
+        """No retained connection; process exit leaves durable claims unchanged."""
+
+    def claim_writer(self, account_ref: str, owner_id: str) -> WriterEpochV1:
+        _require_account_ref(account_ref)
+        _require_text(owner_id, "owner_id")
+        token = secrets.token_urlsafe(40)
+        token_hash = _sha256(token)
+        with self._local_lock, self._transaction() as cursor:
+            if self._has_claimed_dispatch_cursor(cursor, account_ref):
+                raise ActorServerError("dispatch_claim_in_flight")
+            row = cursor.execute(
+                "SELECT epoch, state FROM actor_account_writers WHERE account_ref=?",
+                (account_ref,),
+            ).fetchone()
+            if row is not None and row[1] == "ACTIVE":
+                raise ActorServerError("account_writer_already_claimed")
+            epoch = 1 if row is None else _exact_db_int(row[0], "writer epoch") + 1
+            if row is None:
+                cursor.execute(
+                    "INSERT INTO actor_account_writers"
+                    "(account_ref, epoch, owner_id, token_sha256, state, context_json)"
+                    " VALUES (?, ?, ?, ?, 'ACTIVE', NULL)",
+                    (account_ref, epoch, owner_id, token_hash),
+                )
+            else:
+                cursor.execute(
+                    "UPDATE actor_account_writers SET epoch=?, owner_id=?, token_sha256=?,"
+                    " state='ACTIVE', context_json=NULL WHERE account_ref=? AND state='REVOKED'",
+                    (epoch, owner_id, token_hash, account_ref),
+                )
+                if cursor.rowcount != 1:
+                    raise ActorServerError("account_writer_claim_conflict")
+        return WriterEpochV1(account_ref, owner_id, epoch, token)
+
+    def bind_session(
+        self, writer: WriterEpochV1, context: ActorCommandContextV1
+    ) -> None:
+        """Bind one exact local session context to this epoch."""
+
+        if type(context) is not ActorCommandContextV1:
+            raise ActorServerError("session_context_type_invalid")
+        try:
+            context.__post_init__()
+            _require_account_ref(context.account_ref)
+        except (TypeError, ValueError):
+            raise ActorServerError("session_context_invalid") from None
+        if (
+            context.account_ref != writer.account_ref
+            or context.actor_epoch != writer.epoch
+        ):
+            raise ActorServerError("session_context_writer_mismatch")
+        context_json = _canonical_json(context.to_payload())
+        with self._local_lock, self._transaction() as cursor:
+            self._require_writer_cursor(cursor, writer)
+            current = self._session_context_json_cursor(cursor, writer.account_ref)
+            if current is not None:
+                if current != context_json:
+                    raise ActorServerError("session_context_already_bound")
+                return
+            cursor.execute(
+                "UPDATE actor_account_writers SET context_json=?"
+                " WHERE account_ref=? AND epoch=? AND state='ACTIVE' AND context_json IS NULL",
+                (context_json, writer.account_ref, writer.epoch),
+            )
+            if cursor.rowcount != 1:
+                raise ActorServerError("session_context_bind_conflict")
+
+    def revoke_writer(self, writer: WriterEpochV1) -> None:
+        with self._local_lock, self._transaction() as cursor:
+            self._require_writer_cursor(cursor, writer)
+            if self._has_claimed_dispatch_cursor(cursor, writer.account_ref):
+                raise ActorServerError("dispatch_claim_in_flight")
+            cursor.execute(
+                "UPDATE actor_account_writers SET state='REVOKED'"
+                " WHERE account_ref=? AND epoch=? AND owner_id=? AND state='ACTIVE'",
+                (writer.account_ref, writer.epoch, writer.owner_id),
+            )
+            if cursor.rowcount != 1:
+                raise ActorServerError("writer_epoch_revocation_conflict")
+
+    def publish_snapshot(
+        self, writer: WriterEpochV1, bundle: AccountSnapshotBundleV1
+    ) -> SnapshotAuthorityProofV1:
+        authority = self._require_snapshot_authority()
+        _validate_bundle_type(bundle)
+        if bundle.account_ref != writer.account_ref:
+            raise ActorServerError("snapshot_account_mismatch")
+        proof = authority.attest(bundle)
+        if type(proof) is not SnapshotAuthorityProofV1 or not authority.verify(
+            bundle, proof
+        ):
+            raise ActorServerError("snapshot_authority_proof_invalid")
+        with self._local_lock, self._transaction() as cursor:
+            self._require_writer_cursor(cursor, writer)
+            existing = cursor.execute(
+                "SELECT source_id, authority_id, snapshot_digest, proof_hex"
+                " FROM actor_snapshots WHERE account_ref=? AND snapshot_version=?",
+                (bundle.account_ref, bundle.snapshot_version),
+            ).fetchone()
+            if existing is not None:
+                if tuple(existing) == (
+                    bundle.source_id,
+                    proof.authority_id,
+                    proof.snapshot_digest,
+                    proof.proof_hex,
+                ) and self._snapshot_matches_cursor(
+                    cursor, bundle.account_ref, bundle.snapshot_version
+                ):
+                    return proof
+                raise ActorServerError("snapshot_version_conflict")
+            current = cursor.execute(
+                "SELECT snapshot_version FROM actor_current_snapshots WHERE account_ref=?",
+                (bundle.account_ref,),
+            ).fetchone()
+            if current is not None and bundle.snapshot_version <= current[0]:
+                raise ActorServerError("snapshot_version_not_increasing")
+            if self._has_claimed_dispatch_cursor(cursor, writer.account_ref):
+                raise ActorServerError("dispatch_claim_in_flight")
+            cursor.execute(
+                "UPDATE actor_dispatch_lifecycle SET state='REVOKED'"
+                " WHERE state='AVAILABLE' AND dispatch_id IN ("
+                " SELECT dispatch_id FROM actor_dispatch_outbox WHERE account_ref=?)",
+                (writer.account_ref,),
+            )
+            cursor.execute(
+                "UPDATE actor_commands SET state='BLOCKED' WHERE account_ref=?"
+                " AND state='AUTHORIZED' AND EXISTS ("
+                " SELECT 1 FROM actor_dispatch_outbox o"
+                " JOIN actor_dispatch_lifecycle l USING(dispatch_id)"
+                " WHERE o.account_ref=actor_commands.account_ref"
+                " AND o.operation=actor_commands.operation"
+                " AND o.intent_id=actor_commands.intent_id AND l.state='REVOKED')",
+                (writer.account_ref,),
+            )
+            cursor.execute(
+                "INSERT INTO actor_snapshots"
+                "(account_ref, snapshot_version, source_id, authority_id, snapshot_digest, proof_hex)"
+                " VALUES (?, ?, ?, ?, ?, ?)",
+                (
+                    bundle.account_ref,
+                    bundle.snapshot_version,
+                    bundle.source_id,
+                    proof.authority_id,
+                    proof.snapshot_digest,
+                    proof.proof_hex,
+                ),
+            )
+            cursor.executemany(
+                "INSERT INTO actor_snapshot_domains"
+                "(account_ref, snapshot_version, domain, source_id, payload_json)"
+                " VALUES (?, ?, ?, ?, ?)",
+                [
+                    (
+                        bundle.account_ref,
+                        bundle.snapshot_version,
+                        fact.domain,
+                        fact.source_id,
+                        fact.payload_json,
+                    )
+                    for fact in bundle.facts
+                ],
+            )
+            cursor.execute(
+                "INSERT INTO actor_current_snapshots(account_ref, snapshot_version) VALUES (?, ?)"
+                " ON CONFLICT(account_ref) DO UPDATE SET snapshot_version=excluded.snapshot_version",
+                (bundle.account_ref, bundle.snapshot_version),
+            )
+        return proof
+
+    def reserve_intent(
+        self,
+        writer: WriterEpochV1,
+        intent: AccountActorIntentV1,
+        *,
+        expected_snapshot_version: int,
+    ) -> DurableCommandV1:
+        _validate_intent_type(intent)
+        if type(expected_snapshot_version) is not int or expected_snapshot_version <= 0:
+            raise ActorServerError("snapshot_version_invalid")
+        self._require_context_for_writer(writer, intent)
+        with self._local_lock, self._transaction() as cursor:
+            self._require_writer_cursor(cursor, writer)
+            self._require_session_context_cursor(cursor, writer, intent.context)
+            self._require_current_verified_snapshot_cursor(
+                cursor, intent.context.account_ref, expected_snapshot_version
+            )
+            row = cursor.execute(
+                "SELECT command_digest, context_json, payload_json, expected_snapshot_version,"
+                " writer_epoch, state"
+                " FROM actor_commands WHERE account_ref=? AND operation=? AND intent_id=?",
+                (intent.context.account_ref, intent.operation, intent.intent_id),
+            ).fetchone()
+            if row is not None:
+                if (
+                    row[0] != intent.command_digest
+                    or row[3] != expected_snapshot_version
+                    or not _stored_command_is_valid(
+                        account_ref=intent.context.account_ref,
+                        operation=intent.operation,
+                        intent_id=intent.intent_id,
+                        command_digest=row[0],
+                        context_json=row[1],
+                        payload_json=row[2],
+                        expected_epoch=writer.epoch,
+                        expected_context_json=self._session_context_json_cursor(
+                            cursor, writer.account_ref
+                        ),
+                    )
+                ):
+                    raise ActorServerError("intent_replay_conflict")
+                return DurableCommandV1(
+                    intent.context.account_ref,
+                    intent.operation,
+                    intent.intent_id,
+                    row[0],
+                    row[3],
+                    row[4],
+                    row[5],
+                )
+            cursor.execute(
+                "INSERT INTO actor_commands"
+                "(account_ref, operation, intent_id, command_digest, context_json, payload_json,"
+                " expected_snapshot_version, writer_epoch, state)"
+                " VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'RESERVED')",
+                (
+                    intent.context.account_ref,
+                    intent.operation,
+                    intent.intent_id,
+                    intent.command_digest,
+                    intent.context_json,
+                    intent.payload_json,
+                    expected_snapshot_version,
+                    writer.epoch,
+                ),
+            )
+            return DurableCommandV1(
+                intent.context.account_ref,
+                intent.operation,
+                intent.intent_id,
+                intent.command_digest,
+                expected_snapshot_version,
+                writer.epoch,
+                "RESERVED",
+            )
+
+    def authorize_dispatch(
+        self,
+        writer: WriterEpochV1,
+        *,
+        operation: str,
+        intent_id: str,
+    ) -> DispatchAuthorizationV1:
+        """Append or replay a local authorization row after a current check.
+
+        The returned value identifies an outbox row; it is not a dispatch
+        credential. A consumer must pass it to ``claim_for_dispatch`` for the
+        one-shot final check. This method never calls a provider or SDK.
+        """
+
+        if type(operation) is not str or operation not in _OPERATIONS:
+            raise ActorServerError("operation_invalid")
+        _require_text(intent_id, "intent_id")
+        authority = self._require_snapshot_authority()
+        failure_code = None
+        authorization = None
+        with self._local_lock, self._transaction() as cursor:
+            self._require_writer_cursor(cursor, writer)
+            expected_context_json = self._session_context_json_cursor(
+                cursor, writer.account_ref
+            )
+            if expected_context_json is None:
+                raise ActorServerError("writer_session_unbound")
+            row = cursor.execute(
+                "SELECT command_digest, context_json, payload_json, expected_snapshot_version,"
+                " writer_epoch, state"
+                " FROM actor_commands WHERE account_ref=? AND operation=? AND intent_id=?",
+                (writer.account_ref, operation, intent_id),
+            ).fetchone()
+            if row is None:
+                raise ActorServerError("intent_not_reserved")
+            (
+                command_digest,
+                context_json,
+                payload_json,
+                snapshot_version,
+                command_epoch,
+                state,
+            ) = row
+            if command_epoch != writer.epoch:
+                raise ActorServerError("command_writer_epoch_mismatch")
+            if not _stored_command_is_valid(
+                account_ref=writer.account_ref,
+                operation=operation,
+                intent_id=intent_id,
+                command_digest=command_digest,
+                context_json=context_json,
+                payload_json=payload_json,
+                expected_epoch=writer.epoch,
+                expected_context_json=expected_context_json,
+            ):
+                raise ActorServerError("command_binding_readback_mismatch")
+            if state == "AUTHORIZED":
+                outbox = cursor.execute(
+                    "SELECT dispatch_id, command_digest, writer_epoch, snapshot_version"
+                    " FROM actor_dispatch_outbox WHERE account_ref=? AND operation=? AND intent_id=?",
+                    (writer.account_ref, operation, intent_id),
+                ).fetchone()
+                if outbox is None or tuple(outbox[1:]) != (
+                    command_digest,
+                    writer.epoch,
+                    snapshot_version,
+                ):
+                    raise ActorServerError("dispatch_outbox_readback_mismatch")
+                dispatch_id = _exact_db_int(outbox[0], "dispatch_id")
+                lifecycle = cursor.execute(
+                    "SELECT state FROM actor_dispatch_lifecycle WHERE dispatch_id=?",
+                    (dispatch_id,),
+                ).fetchone()
+                if lifecycle is None:
+                    raise ActorServerError("dispatch_lifecycle_readback_mismatch")
+                try:
+                    self._require_current_verified_snapshot_cursor(
+                        cursor,
+                        writer.account_ref,
+                        snapshot_version,
+                        authority=authority,
+                    )
+                except ActorServerError:
+                    if lifecycle[0] == "AVAILABLE":
+                        cursor.execute(
+                            "UPDATE actor_dispatch_lifecycle SET state='REVOKED'"
+                            " WHERE dispatch_id=? AND state='AVAILABLE'",
+                            (dispatch_id,),
+                        )
+                        cursor.execute(
+                            "UPDATE actor_commands SET state='BLOCKED'"
+                            " WHERE account_ref=? AND operation=? AND intent_id=?"
+                            " AND state='AUTHORIZED'",
+                            (writer.account_ref, operation, intent_id),
+                        )
+                    failure_code = "dispatch_authorization_stale"
+                else:
+                    if lifecycle[0] != "AVAILABLE":
+                        failure_code = (
+                            "dispatch_authorization_stale"
+                            if lifecycle[0] == "REVOKED"
+                            else "dispatch_authorization_consumed"
+                        )
+                    else:
+                        authorization = DispatchAuthorizationV1(
+                            writer.account_ref,
+                            operation,
+                            intent_id,
+                            command_digest,
+                            writer.epoch,
+                            snapshot_version,
+                            dispatch_id,
+                        )
+            elif state == "BLOCKED":
+                lifecycle = cursor.execute(
+                    "SELECT l.state FROM actor_dispatch_outbox o"
+                    " JOIN actor_dispatch_lifecycle l USING(dispatch_id)"
+                    " WHERE o.account_ref=? AND o.operation=? AND o.intent_id=?",
+                    (writer.account_ref, operation, intent_id),
+                ).fetchone()
+                if lifecycle is not None and lifecycle[0] == "REVOKED":
+                    failure_code = "dispatch_authorization_stale"
+                else:
+                    failure_code = "intent_state_not_dispatchable"
+            elif state == "RESERVED":
+                self._require_current_verified_snapshot_cursor(
+                    cursor,
+                    writer.account_ref,
+                    snapshot_version,
+                    authority=authority,
+                )
+                cursor.execute(
+                    "INSERT INTO actor_dispatch_outbox"
+                    "(account_ref, operation, intent_id, command_digest, writer_epoch, snapshot_version)"
+                    " VALUES (?, ?, ?, ?, ?, ?)",
+                    (
+                        writer.account_ref,
+                        operation,
+                        intent_id,
+                        command_digest,
+                        writer.epoch,
+                        snapshot_version,
+                    ),
+                )
+                dispatch_id = _exact_db_int(cursor.lastrowid, "dispatch_id")
+                cursor.execute(
+                    "INSERT INTO actor_dispatch_lifecycle(dispatch_id,state)"
+                    " VALUES (?, 'AVAILABLE')",
+                    (dispatch_id,),
+                )
+                cursor.execute(
+                    "UPDATE actor_commands SET state='AUTHORIZED'"
+                    " WHERE account_ref=? AND operation=? AND intent_id=? AND state='RESERVED'",
+                    (writer.account_ref, operation, intent_id),
+                )
+                if cursor.rowcount != 1:
+                    raise ActorServerError("intent_authorization_conflict")
+                authorization = DispatchAuthorizationV1(
+                    writer.account_ref,
+                    operation,
+                    intent_id,
+                    command_digest,
+                    writer.epoch,
+                    snapshot_version,
+                    dispatch_id,
+                )
+            else:
+                raise ActorServerError("intent_state_not_dispatchable")
+        if failure_code is not None:
+            raise ActorServerError(failure_code)
+        if authorization is None:
+            raise ActorServerError("dispatch_authorization_readback_mismatch")
+        return authorization
+
+    def claim_for_dispatch(
+        self,
+        writer: WriterEpochV1,
+        authorization: DispatchAuthorizationV1,
+    ) -> DispatchClaimV1:
+        """Consume an outbox authorization at the final local dispatch gate.
+
+        This method never calls a provider. The one-shot claim pins the exact
+        writer epoch and snapshot: publishing a newer snapshot or revoking or
+        reclaiming the writer is rejected while it remains CLAIMED. There is
+        deliberately no release or completion API in this fake candidate, so
+        process death leaves the account frozen instead of risking replay.
+        """
+
+        if type(authorization) is not DispatchAuthorizationV1:
+            raise ActorServerError("dispatch_authorization_type_invalid")
+        try:
+            authorization.__post_init__()
+        except (TypeError, ValueError):
+            raise ActorServerError("dispatch_authorization_invalid") from None
+        if type(writer) is not WriterEpochV1:
+            raise ActorServerError("writer_epoch_type_invalid")
+        authority = self._require_snapshot_authority()
+        failure_code = None
+        claim = None
+        with self._local_lock, self._transaction() as cursor:
+            self._require_writer_cursor(cursor, writer)
+            expected_context_json = self._session_context_json_cursor(
+                cursor, writer.account_ref
+            )
+            if expected_context_json is None:
+                raise ActorServerError("writer_session_unbound")
+            row = cursor.execute(
+                "SELECT c.command_digest, c.context_json, c.payload_json,"
+                " c.expected_snapshot_version, c.writer_epoch, c.state,"
+                " o.dispatch_id, o.command_digest, o.writer_epoch, o.snapshot_version,"
+                " l.state FROM actor_commands c"
+                " JOIN actor_dispatch_outbox o USING(account_ref,operation,intent_id)"
+                " JOIN actor_dispatch_lifecycle l USING(dispatch_id)"
+                " WHERE c.account_ref=? AND c.operation=? AND c.intent_id=?",
+                (writer.account_ref, authorization.operation, authorization.intent_id),
+            ).fetchone()
+            if row is None:
+                raise ActorServerError("dispatch_authorization_not_found")
+            (
+                command_digest,
+                context_json,
+                payload_json,
+                command_snapshot_version,
+                command_epoch,
+                command_state,
+                dispatch_id,
+                outbox_digest,
+                outbox_epoch,
+                outbox_snapshot_version,
+                lifecycle_state,
+            ) = row
+            if not _stored_command_is_valid(
+                account_ref=writer.account_ref,
+                operation=authorization.operation,
+                intent_id=authorization.intent_id,
+                command_digest=command_digest,
+                context_json=context_json,
+                payload_json=payload_json,
+                expected_epoch=writer.epoch,
+                expected_context_json=expected_context_json,
+            ):
+                raise ActorServerError("command_binding_readback_mismatch")
+            if (
+                command_state != "AUTHORIZED"
+                or command_epoch != writer.epoch
+                or command_snapshot_version != authorization.snapshot_version
+                or outbox_digest != command_digest
+                or outbox_epoch != writer.epoch
+                or outbox_snapshot_version != command_snapshot_version
+                or _exact_db_int(dispatch_id, "dispatch_id") != authorization.dispatch_id
+                or authorization.account_ref != writer.account_ref
+                or authorization.command_digest != command_digest
+                or authorization.writer_epoch != writer.epoch
+                or lifecycle_state != "AVAILABLE"
+            ):
+                raise ActorServerError("dispatch_authorization_not_available")
+            try:
+                self._require_current_verified_snapshot_cursor(
+                    cursor,
+                    writer.account_ref,
+                    command_snapshot_version,
+                    authority=authority,
+                )
+            except ActorServerError:
+                cursor.execute(
+                    "UPDATE actor_dispatch_lifecycle SET state='REVOKED'"
+                    " WHERE dispatch_id=? AND state='AVAILABLE'",
+                    (authorization.dispatch_id,),
+                )
+                cursor.execute(
+                    "UPDATE actor_commands SET state='BLOCKED'"
+                    " WHERE account_ref=? AND operation=? AND intent_id=?"
+                    " AND state='AUTHORIZED'",
+                    (writer.account_ref, authorization.operation, authorization.intent_id),
+                )
+                failure_code = "dispatch_authorization_stale"
+            else:
+                cursor.execute(
+                    "UPDATE actor_dispatch_lifecycle SET state='CLAIMED'"
+                    " WHERE dispatch_id=? AND state='AVAILABLE'",
+                    (authorization.dispatch_id,),
+                )
+                if cursor.rowcount != 1:
+                    raise ActorServerError("dispatch_claim_conflict")
+                claim = DispatchClaimV1(
+                    writer.account_ref,
+                    authorization.operation,
+                    authorization.intent_id,
+                    command_digest,
+                    writer.epoch,
+                    command_snapshot_version,
+                    authorization.dispatch_id,
+                )
+        if failure_code is not None:
+            raise ActorServerError(failure_code)
+        if claim is None:
+            raise ActorServerError("dispatch_claim_readback_mismatch")
+        return claim
+
+    def read_dispatch_state(
+        self, account_ref: str, operation: str, intent_id: str
+    ) -> str:
+        """Read the durable final-gate lifecycle state for a local outbox row."""
+
+        _require_account_ref(account_ref)
+        if type(operation) is not str or operation not in _OPERATIONS:
+            raise ActorServerError("operation_invalid")
+        _require_text(intent_id, "intent_id")
+        with closing(self._connect()) as connection:
+            row = connection.execute(
+                "SELECT l.state FROM actor_dispatch_outbox o"
+                " JOIN actor_dispatch_lifecycle l USING(dispatch_id)"
+                " WHERE o.account_ref=? AND o.operation=? AND o.intent_id=?",
+                (account_ref, operation, intent_id),
+            ).fetchone()
+        if row is None:
+            raise ActorServerError("dispatch_authorization_not_found")
+        return row[0]
+
+    def count_dispatch_rows(self, account_ref: str) -> int:
+        _require_account_ref(account_ref)
+        with closing(self._connect()) as connection:
+            row = connection.execute(
+                "SELECT COUNT(*) FROM actor_dispatch_outbox WHERE account_ref=?",
+                (account_ref,),
+            ).fetchone()
+            return _exact_db_int(row[0], "outbox count")
+
+    def read_writer_epoch(self, account_ref: str) -> tuple[int, str, str]:
+        _require_account_ref(account_ref)
+        with closing(self._connect()) as connection:
+            row = connection.execute(
+                "SELECT epoch, owner_id, state FROM actor_account_writers WHERE account_ref=?",
+                (account_ref,),
+            ).fetchone()
+        if row is None:
+            raise ActorServerError("writer_not_found")
+        return _exact_db_int(row[0], "writer epoch"), row[1], row[2]
+
+    def _initialize_schema(self) -> None:
+        connection = self._connect()
+        try:
+            connection.execute("PRAGMA foreign_keys=ON")
+            version = connection.execute("PRAGMA user_version").fetchone()[0]
+            user_tables = {
+                row[0]
+                for row in connection.execute(
+                    "SELECT name FROM sqlite_master WHERE name NOT LIKE 'sqlite_%'"
+                )
+            }
+            if version == 0:
+                if user_tables:
+                    raise ActorServerError("database_schema_unsupported")
+            elif version == 1:
+                self._validate_schema(
+                    connection,
+                    user_tables,
+                    schema_ddl=_SCHEMA_V1_DDL,
+                    schema_columns=_SCHEMA_V1_COLUMNS,
+                )
+                self._migrate_v1_to_v2(connection)
+                migrated_tables = {
+                    row[0]
+                    for row in connection.execute(
+                        "SELECT name FROM sqlite_master WHERE name NOT LIKE 'sqlite_%'"
+                    )
+                }
+                self._validate_schema(connection, migrated_tables)
+                return
+            elif version == _SCHEMA_VERSION:
+                self._validate_schema(connection, user_tables)
+                return
+            else:
+                raise ActorServerError("database_schema_unsupported")
+            connection.executescript(
+                "BEGIN IMMEDIATE;"
+                + ";".join(_SCHEMA_DDL.values())
+                + f";PRAGMA user_version={_SCHEMA_VERSION};COMMIT;"
+            )
+        finally:
+            connection.close()
+
+    @staticmethod
+    def _validate_schema(
+        connection: sqlite3.Connection,
+        user_tables: set[str],
+        *,
+        schema_ddl=None,
+        schema_columns=None,
+    ) -> None:
+        schema_ddl = _SCHEMA_DDL if schema_ddl is None else schema_ddl
+        schema_columns = _SCHEMA_COLUMNS if schema_columns is None else schema_columns
+        if user_tables != set(schema_columns):
+            raise ActorServerError("database_schema_shape_invalid")
+        objects = connection.execute(
+            "SELECT type, name, sql FROM sqlite_master WHERE name NOT LIKE 'sqlite_%'"
+        ).fetchall()
+        if len(objects) != len(schema_ddl):
+            raise ActorServerError("database_schema_shape_invalid")
+        for object_type, name, sql in objects:
+            expected = schema_ddl.get(name)
+            if (
+                object_type != "table"
+                or expected is None
+                or _normalize_sql(sql) != _normalize_sql(expected)
+            ):
+                raise ActorServerError("database_schema_shape_invalid")
+        for table, expected_columns in schema_columns.items():
+            actual_columns = tuple(
+                row[1] for row in connection.execute(f"PRAGMA table_info({table})")
+            )
+            if actual_columns != expected_columns:
+                raise ActorServerError("database_schema_shape_invalid")
+
+    @staticmethod
+    def _migrate_v1_to_v2(connection: sqlite3.Connection) -> None:
+        """Preserve v1 outbox rows as revoked audit history.
+
+        A v1 outbox may already have escaped to an unknown consumer, so the
+        migration deliberately never upgrades it into an available claim.
+        """
+
+        connection.execute("BEGIN IMMEDIATE")
+        try:
+            version = connection.execute("PRAGMA user_version").fetchone()[0]
+            if version == _SCHEMA_VERSION:
+                tables = {
+                    row[0]
+                    for row in connection.execute(
+                        "SELECT name FROM sqlite_master WHERE name NOT LIKE 'sqlite_%'"
+                    )
+                }
+                AccountActorServerCoreV1._validate_schema(connection, tables)
+                connection.commit()
+                return
+            if version != 1:
+                raise ActorServerError("database_schema_unsupported")
+            tables = {
+                row[0]
+                for row in connection.execute(
+                    "SELECT name FROM sqlite_master WHERE name NOT LIKE 'sqlite_%'"
+                )
+            }
+            AccountActorServerCoreV1._validate_schema(
+                connection,
+                tables,
+                schema_ddl=_SCHEMA_V1_DDL,
+                schema_columns=_SCHEMA_V1_COLUMNS,
+            )
+            if connection.execute("PRAGMA foreign_key_check").fetchone() is not None:
+                raise ActorServerError("database_v1_integrity_invalid")
+
+            outbox_rows = connection.execute(
+                "SELECT dispatch_id, account_ref, operation, intent_id, command_digest,"
+                " writer_epoch, snapshot_version FROM actor_dispatch_outbox"
+            ).fetchall()
+            authorized_commands = connection.execute(
+                "SELECT account_ref, operation, intent_id, command_digest,"
+                " writer_epoch, expected_snapshot_version FROM actor_commands"
+                " WHERE state='AUTHORIZED'"
+            ).fetchall()
+            by_key = {
+                (row[1], row[2], row[3]): row
+                for row in outbox_rows
+            }
+            if len(by_key) != len(outbox_rows) or len(authorized_commands) != len(outbox_rows):
+                raise ActorServerError("database_v1_authorization_history_invalid")
+            for command in authorized_commands:
+                outbox = by_key.get((command[0], command[1], command[2]))
+                if outbox is None or tuple(command[3:]) != tuple(outbox[4:7]):
+                    raise ActorServerError("database_v1_authorization_history_invalid")
+
+            connection.execute(_SCHEMA_DDL["actor_dispatch_lifecycle"])
+            connection.executemany(
+                "INSERT INTO actor_dispatch_lifecycle(dispatch_id,state) VALUES (?, 'REVOKED')",
+                [(_exact_db_int(row[0], "dispatch_id"),) for row in outbox_rows],
+            )
+            connection.execute(
+                "UPDATE actor_commands SET state='BLOCKED' WHERE state='AUTHORIZED'"
+            )
+            connection.execute(f"PRAGMA user_version={_SCHEMA_VERSION}")
+            connection.commit()
+        except Exception:
+            connection.rollback()
+            raise
