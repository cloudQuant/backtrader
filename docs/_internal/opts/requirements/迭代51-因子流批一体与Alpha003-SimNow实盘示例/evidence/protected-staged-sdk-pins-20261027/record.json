    "runner_source": "\"\"\"Read-only installed CTP artifact admission check; never enters protected config.\"\"\"\nimport argparse, dataclasses, hashlib, importlib.util, json, sys\nfrom pathlib import Path\n\nOLD_CTP_RECORD = \"ec812e9940d462bf46c4725b20a7a06d934b0ceb1266ee6f96ae5d2c89829d43\"\nNAMES = (\"bt_api_base\", \"bt_api_ctp\")\n\ndef _relative(path, root):\n    return Path(path).resolve(strict=True).relative_to(root).as_posix()\n\ndef main():\n    report = {\"schema\": \"i51_protected_sdk_admission.v1\", \"status\": \"HOLD\",\n              \"phase\": \"arguments\", \"positive_validation\": False,\n              \"negative_record_pin_rejected\": False}\n    phase = \"arguments\"\n    try:\n        parser = argparse.ArgumentParser()\n        parser.add_argument(\"--consumer-root\", required=True, type=Path)\n        parser.add_argument(\"--protected-source-sha256\", required=True)\n        args = parser.parse_args()\n        root = args.consumer_root.resolve(strict=True)\n        if (sys.flags.isolated != 1 or not sys.dont_write_bytecode\n                or Path(sys.prefix).resolve(strict=True) != root):\n            raise ValueError\n        repo = Path(__file__).resolve(strict=True).parents[1]\n        protected_path = repo / \"examples/unified/028_alpha003_simnow_minute/protected_simnow.py\"\n        protected_sha = hashlib.sha256(protected_path.read_bytes()).hexdigest()\n        if protected_sha != args.protected_source_sha256.lower():\n            raise ValueError\n        phase = \"installed_origins\"\n        import backtrader_runtime\n        from backtrader_runtime import capability_imports, ctp_artifact_provenance\n        origins = {\n            \"backtrader_runtime\": _relative(backtrader_runtime.__file__, root),\n            \"capability_imports\": _relative(capability_imports.__file__, root),\n            \"ctp_artifact_provenance\": _relative(ctp_artifact_provenance.__file__, root),\n        }\n        spec = importlib.util.spec_from_file_location(\"_i51_public_protected_simnow\", protected_path)\n        if spec is None or spec.loader is None:\n            raise ValueError\n        protected = importlib.util.module_from_spec(spec)\n        spec.loader.exec_module(protected)\n        if (hashlib.sha256(protected_path.read_bytes()).hexdigest() != protected_sha\n                or Path(protected.__file__).resolve(strict=True) != protected_path.resolve(strict=True)):\n            raise ValueError\n        origins[\"protected_simnow\"] = protected_path.relative_to(repo).as_posix()\n        pins = protected._SDK_PINS\n        if tuple(pins) != NAMES:\n            raise ValueError\n        if any(type(pins[name]) is not ctp_artifact_provenance.CtpSdkArtifactPin for name in NAMES):\n            raise ValueError\n        verifier = protected._verify_pinned_sdk_distributions\n        if (verifier.__module__ != ctp_artifact_provenance.__name__\n                or Path(verifier.__code__.co_filename).resolve(strict=True)\n                != Path(ctp_artifact_provenance.__file__).resolve(strict=True)):\n            raise ValueError\n        phase = \"positive_validation\"\n        with capability_imports.trusted_installed_capability_import_context(NAMES):\n            package_roots = verifier(NAMES, pins=pins)\n        if type(package_roots) is not dict or tuple(package_roots) != NAMES:\n            raise ValueError\n        origins.update({name: _relative(package_roots[name], root) for name in NAMES})\n        report[\"positive_validation\"] = True\n        phase = \"negative_record_pin_validation\"\n        ctp_pin = pins[\"bt_api_ctp\"]\n        old_record = \"ec812e9940d462bf46c4725b20a7a06d934b0ceb1266ee6f96ae5d2c89829d43\"\n        if ctp_pin.record_sha256 == old_record:\n            raise ValueError\n        negative_pins = dict(pins)\n        negative_pins[\"bt_api_ctp\"] = dataclasses.replace(ctp_pin, record_sha256=old_record)\n        if negative_pins[\"bt_api_base\"] is not pins[\"bt_api_base\"]:\n            raise ValueError\n        try:\n            with capability_imports.trusted_installed_capability_import_context(NAMES):\n                verifier(NAMES, pins=negative_pins)\n        except ctp_artifact_provenance.CtpArtifactProvenanceError as error:\n            report[\"negative_record_pin_rejected\"] = (\n                type(error) is ctp_artifact_provenance.CtpArtifactProvenanceError\n                and type(error.reason) is str and error.reason == \"artifact_record_pin_mismatch\"\n            )\n        if report[\"negative_record_pin_rejected\"] is not True:\n            raise ValueError\n        report.update(\n            status=\"PASS\",\n            phase=\"complete\",\n            protected_source_sha256=protected_sha,\n            pins={\n                name: {\n                    \"distribution\": pins[name].distribution,\n                    \"module\": pins[name].module,\n                    \"version\": pins[name].version,\n                    \"wheel_filename\": pins[name].wheel_filename,\n                    \"wheel_sha256\": pins[name].wheel_sha256,\n                    \"record_sha256\": pins[name].record_sha256,\n                }\n                for name in NAMES\n            },\n            origins=origins,\n        )\n    except BaseException:\n        report[\"phase\"] = phase\n    print(json.dumps(report, sort_keys=True, separators=(\",\", \":\")))\n    return 0 if report[\"status\"] == \"PASS\" else 1\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n",
