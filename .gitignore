# mkdocs documentation
/site

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# OS junk (Windows redirect slips such as `nul` land in the repo root)
.DS_Store
Thumbs.db
Desktop.ini
nul

# ---------------------------------------------------------------------------
# Local workspace / agent scratch — never commit
# ---------------------------------------------------------------------------
# .codex-tmp is the repository QA scratch root (pytest --basetemp trees,
# JUnit XML, one-shot receipts). It holds hundreds of megabytes of per-run
# output and must stay out of every commit.
.codex-tmp/
.agent/
.agents/
.claude/
.codebuddy/
.cursor/
.idea/
.kiro/skills/
.opencode/
.qoder/
.qwen/
.vscode/
_bmad/
/assets/
/promotion/
.readthedocs-zh.yaml
bandit-report.json
# Root-level copies only: scripts/optimize_code.sh is tracked source.
/optimize_code.sh
/fix_readme.py

# ---------------------------------------------------------------------------
# Generated outputs from examples, reports and regression tests
# ---------------------------------------------------------------------------
# `evidence/` hides scratch evidence at any depth. The pinned acceptance
# archives under docs/_internal/**/evidence/ are tracked, so they are
# unaffected; new files added there need `git add -f` by design.
evidence/
logs/
*.log
/examples/output/
/examples/**/output/
examples/backtest/003_hft_notebook_examples/data/
report.html
backtrader_remove_metaprogramming_report.html
backtrader_master_tests_report.html
backtrader_remove_metaprogramming_report_timing.json
performance_comparison.json
tests/functional/datas/
tests/functional/strategies_regression/

# Auto-generated transient outputs from regression tests
tests/functional/strategies/**/strategy_backtest_results.csv
tests/functional/strategies/**/backtest_result.json
tests/functional/strategy_backtest_results.csv
tests/functional/**/backtest_result.json

# Local git worktrees for branch comparison (should not be tracked)
.branch_compare_worktrees/
.worktrees/

